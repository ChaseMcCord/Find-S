#!/usr/bin/env python3
"""
extract_s_words.py

Usage:
    python extract_s_words.py /path/to/file.pdf [--case-insensitive] [--output out.txt] [--unique]

Extracts words that begin with "S" from the specified PDF.
"""
import argparse
import re
import sys

try:
    from PyPDF2 import PdfReader
except Exception:
    sys.exit("PyPDF2 is required. Install with: pip install PyPDF2")

def extract_text_from_pdf(path):
    reader = PdfReader(path)
    text_parts = []
    for page in reader.pages:
        txt = page.extract_text()
        if txt:
            text_parts.append(txt)
    return "\n".join(text_parts)

def find_s_words(text, case_insensitive=False):
    if case_insensitive:
        pattern = r"\b[Ss]\w*"
    else:
        pattern = r"\bS\w*"
    return re.findall(pattern, text)

def main():
    parser = argparse.ArgumentParser(description="Extract words beginning with 'S' from a PDF.")
    parser.add_argument("pdf", help="Path to the PDF file")
    parser.add_argument("--case-insensitive", "-i", action="store_true",
                        help="Match both 'S' and 's' at the start of words")
    parser.add_argument("--output", "-o", help="Write results (one per line) to this file")
    parser.add_argument("--unique", "-u", action="store_true", help="Return unique words only (sorted)")
    args = parser.parse_args()

    try:
        text = extract_text_from_pdf(args.pdf)
    except FileNotFoundError:
        sys.exit(f"File not found: {args.pdf}")
    except Exception as e:
        sys.exit(f"Error reading PDF: {e}")

    matches = find_s_words(text, case_insensitive=args.case_insensitive)

    if args.unique:
        if args.case_insensitive:
            unique = sorted({m.lower(): m for m in matches}.values(), key=lambda s: s.lower())
        else:
            unique = sorted(set(matches))
        results = unique
    else:
        results = matches

    if args.output:
        try:
            with open(args.output, "w", encoding="utf-8") as f:
                for w in results:
                    f.write(w + "\n")
            print(f"Wrote {len(results)} results to {args.output}")
        except Exception as e:
            sys.exit(f"Error writing output file: {e}")
    else:
        for w in results:
            print(w)

if __name__ == "__main__":
    main()
